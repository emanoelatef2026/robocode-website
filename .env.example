# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App session
LMS_SESSION_SECRET=

# Cron (app/api/cron/*) — required in production so cron routes reject
# public/unauthenticated calls. Vercel Cron sends this automatically as
# `Authorization: Bearer $CRON_SECRET` once the var is set on the project.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CRON_SECRET=your-secret-here

# Optional — if set (along with RESEND_API_KEY), app/api/cron/integrity-check
# emails this address when a daily integrity threshold is breached. If unset,
# the route still returns a non-200 status on breach for Vercel Cron
# Monitoring to catch.
INTEGRITY_ALERT_EMAIL=
