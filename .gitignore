# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Code local settings (per-developer permission cache — never shared)
.claude/settings.local.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local cache (project ref/connection metadata, regenerated per machine)
/supabase/.temp

# One-off ops script outputs that may contain production PII — never commit
backfill-org-emails-*.csv

# graphify knowledge graph — fully regenerated locally (graphify update .),
# rebuilt by a per-machine post-commit hook, and non-mergeable JSON blobs.
# Tracking any of it guarantees merge conflicts between machines. See
# docs/DEVELOPMENT_WORKFLOW.md for how to regenerate it after a pull.
/graphify-out/
